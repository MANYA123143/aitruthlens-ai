# Streamlit Secrets Configuration for TruthLens AI
# Rename this file to secrets.toml or configure these secrets in Streamlit Community Cloud settings.

# Required: Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"

# Optional: Default Gemini model (default is gemini-2.5-flash or gemini-1.5-flash)
# GEMINI_MODEL = "gemini-2.5-flash"
